project.manifest = manifest.xml

# Source and base resources use the default paths (source, resources), so
# per-language string folders (resources-por, resources-spa, ...) are picked
# up automatically. Base resources hold strings and the launcher icon.
#
# Stretch illustrations ship at several pixel sizes (see
# scripts/generate_illustrations.py). Each product appends the illustration
# bucket that matches its screen resolution, so the artwork stays crisp and
# proportional from the 208x208 Forerunner 55 up to the 466x466 fenix 9 Pro 51mm.
# This mapping is generated into scripts/resource_paths.jungle; keep it in
# sync by re-running the generator.

fr55.resourcePath = $(fr55.resourcePath);assets/illus98

fr255s.resourcePath = $(fr255s.resourcePath);assets/illus102
